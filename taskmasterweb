#!/usr/bin/env python3
import argparse
import sys

from src.web.server import run_server


EXIT_OK = 0
EXIT_ERROR = 1


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """Parse command-line arguments for taskmasterweb."""
    parser = argparse.ArgumentParser(description="Taskmaster Web Dashboard")
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=9001,
        help="HTTP port to bind (default: 9001)",
    )
    parser.add_argument(
        "-H",
        "--host",
        default="127.0.0.1",
        help="Host address to bind (default: 127.0.0.1)",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    try:
        run_server(host=args.host, port=args.port)
    except OSError as error:
        print(f"[taskmasterweb] Error: {error}", file=sys.stderr)
        return EXIT_ERROR
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
