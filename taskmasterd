#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

from src.config import ConfigError, ConfigNotFoundError, PrivilegeError
from src.core.daemon import TaskmasterDaemon
from src.ipc.server import IPCStartError

EXIT_OK = 0
EXIT_CONFIG_ERROR = 1
EXIT_IPC_ERROR = 2


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """
    Parse command-line arguments for taskmasterd.

    Returns:
        argparse.Namespace: Parsed arguments including config path and logging mode.
    """
    parser = argparse.ArgumentParser(description="Taskmaster process supervisor")
    parser.add_argument(
        "-c",
        "--config",
        type=Path,
        default=Path("config.toml"),
        help="Path to the configuration file (default: ./config.toml)",
    )
    parser.set_defaults(log_to_stdout=False)
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "-f",
        "--foreground",
        dest="log_to_stdout",
        action="store_true",
        help="Run in foreground (output colored logs to stdout)",
    )
    group.add_argument(
        "-d",
        "--daemon",
        dest="log_to_stdout",
        action="store_false",
        help="Run in daemon mode (suppress stdout logs, default)",
    )
    args = parser.parse_args(argv)
    if not args.config.is_file():
        raise ConfigNotFoundError(f"configuration file '{args.config}' not found")
    return args


def main(argv: list[str] | None = None) -> int:
    try:
        args = parse_args(argv)
        daemon = TaskmasterDaemon(args.config, log_to_stdout=args.log_to_stdout)
    except (ConfigNotFoundError, ConfigError, PrivilegeError) as error:
        print(f"[taskmasterd] {error}", file=sys.stderr)
        return EXIT_CONFIG_ERROR

    try:
        daemon.run()
    except IPCStartError:
        return EXIT_IPC_ERROR

    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
