#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

from config import ConfigError, ConfigNotFoundError, PrivilegeError
from core import TaskmasterDaemon
from common.exit_codes import EXIT_CONFIG_ERROR, EXIT_PRIVILEGE_ERROR


def get_config_path() -> Path:
    """
    Parse the config path from command-line arguments.

    Returns:
        Path: Path to the config file.
    """
    parser = argparse.ArgumentParser(description="Taskmaster process supervisor")
    parser.add_argument(
        "-c",
        "--config",
        type=Path,
        default=Path("config.toml"),
        help="Path to the configuration file (default: ./config.toml)",
    )
    args = parser.parse_args()
    if not args.config.is_file():
        raise ConfigNotFoundError(f"configuration file '{args.config}' not found")
    return args.config


def main() -> int:
    try:
        config_path = get_config_path()
    except ConfigNotFoundError as e:
        print(f"[taskmaster]: {e}", file=sys.stderr)
        return EXIT_CONFIG_ERROR

    daemon = TaskmasterDaemon(config_path)

    try:
        daemon.load_initial_config()
    except ConfigError as e:
        print(f"[taskmasterd] {e}", file=sys.stderr)
        return EXIT_CONFIG_ERROR

    try:
        daemon.drop_privileges_if_root()
    except PrivilegeError as e:
        print(f"[taskmaster]: {e}", file=sys.stderr)
        return EXIT_PRIVILEGE_ERROR

    daemon.register_signal_handlers()
    daemon.run()


if __name__ == "__main__":
    sys.exit(main())
